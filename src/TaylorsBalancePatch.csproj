<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>TaylorsBalancePatch</AssemblyName>
    <Version>1.1.1</Version>
    <Description>T4ylorSurvivors balance changes for Risk of Rain 2.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="Mono.Cecil" HintPath="$(BepInExCore)\Mono.Cecil.dll" Private="false" />
    <Reference Include="MonoMod.Utils" HintPath="$(BepInExCore)\MonoMod.Utils.dll" Private="false" />
    <Reference Include="MonoMod.RuntimeDetour" HintPath="$(BepInExCore)\MonoMod.RuntimeDetour.dll" Private="false" />
    <Reference Include="MMHOOK_RoR2" HintPath="$(ModProfileDirectory)\BepInEx\plugins\MMHOOK\MMHOOK_RoR2.dll" Private="false" />
    <Reference Include="RoR2" HintPath="$(ManagedDirectory)\RoR2.dll" Private="false" />
    <Reference Include="AK.Wwise.Unity.API" HintPath="$(ManagedDirectory)\AK.Wwise.Unity.API.dll" Private="false" />
    <Reference Include="AK.Wwise.Unity.MonoBehaviour" HintPath="$(ManagedDirectory)\AK.Wwise.Unity.MonoBehaviour.dll" Private="false" />
    <Reference Include="AsyncManagement" HintPath="$(ManagedDirectory)\AsyncManagement.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDirectory)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDirectory)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(ManagedDirectory)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="KinematicCharacterController" HintPath="$(ManagedDirectory)\KinematicCharacterController.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedDirectory)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(ManagedDirectory)\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="com.unity.multiplayer-hlapi.Runtime" HintPath="$(ManagedDirectory)\com.unity.multiplayer-hlapi.Runtime.dll" Private="false" />
  </ItemGroup>
</Project>
